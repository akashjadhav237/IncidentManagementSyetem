@switch (Kind)
{
    case StateKind.Loading:
        <div class="state state-loading" role="status">
            <span class="spinner" aria-hidden="true"></span>
            <span>@(Message ?? "Loading…")</span>
        </div>
        break;

    case StateKind.Empty:
        <div class="state state-empty">
            <span class="state-icon">@Icons.Inbox</span>
            <span>@(Message ?? "Nothing to show yet.")</span>
            @ChildContent
        </div>
        break;

    case StateKind.Error:
        <div class="state state-error" role="alert">
            <span class="state-icon">@Icons.Alert</span>
            <span>@(Message ?? "Something went wrong.")</span>
            @if (OnRetry.HasDelegate)
            {
                <button type="button" class="button button-secondary" @onclick="OnRetry">Retry</button>
            }
            @ChildContent
        </div>
        break;
}

@code {
    [Parameter, EditorRequired] public StateKind Kind { get; set; }
    [Parameter] public string? Message { get; set; }
    [Parameter] public EventCallback OnRetry { get; set; }
    [Parameter] public RenderFragment? ChildContent { get; set; }
}
